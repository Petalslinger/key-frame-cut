# 统一换行：仓库与工作区都用 LF，Windows 的 .bat 例外（cmd 需要 CRLF）
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.exe  binary
